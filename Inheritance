#6)Runtime Polymorphism with Data Members/Instance variables, Repeat the above process only for data member
class A:
    def __init__(self):
        self.var = "Class A"
class B(A):
    def __init__(self):
        super().__init__()  
        self.var = "Class B" 

class C(A):
    def __init__(self):
        super().__init__()
        self.var = "Class C"
obj1: A = B()
obj2: A = C()
print(obj1.var)  
print(obj2.var)
