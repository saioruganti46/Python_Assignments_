#8. Write a program to find Armstrong number or not
n = int(input("")) 
sum_of_digits = 0
temp = n
digits = len(str(n))  
while temp > 0:
    digit = temp % 10
    sum_of_digits += digit ** digits
    temp //= 10  
if n == sum_of_digits:
    print("Armstrong number")
else:
    print("Not an Armstrong number")
